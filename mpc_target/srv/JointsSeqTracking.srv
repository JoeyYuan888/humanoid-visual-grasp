# Request
float64[] states                        # 每个点期望的关节角度（展平） -> 必须指定正确的关节角度个数
int8 joint_num                          # 关节角度个数 -> 0 表示不指定
float64[] time_points                   # 每个点的绝对时间（或每段时长，需约定）
float64 max_period                      # 最大等待周期
float64 weight                          # 每段权重

---
# Response
bool success
string message
