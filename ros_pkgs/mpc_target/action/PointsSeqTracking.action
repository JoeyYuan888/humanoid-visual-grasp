# Goal - 与 PointsSeqTracking.srv 的 Request 一致
geometry_msgs/PoseArray left_poses      # 左手目标序列
geometry_msgs/PoseArray right_poses     # 右手目标序列
float64[] time_points                   # 每个点的绝对时间（或每段时长）
float64 max_period                      # 最大等待周期
float64 weight                          # 每段权重
string type                             # "quintic", "spline"

---
# Result - 与 PointsSeqTracking.srv 的 Response 一致
bool success

---
# Feedback - 执行过程中的进度反馈
uint32 current_segment_index            # 当前所在段索引（0=第1段：起点→第1个waypoint，1=第2段，...）
uint32 total_segments                   # 总段数（= waypoint 数）
float32 segment_progress                # 当前段内进度 0.0 ~ 1.0
float32 progress                        # 整体进度 0.0 ~ 1.0
float64 time_elapsed                    # 已执行时间（秒）
