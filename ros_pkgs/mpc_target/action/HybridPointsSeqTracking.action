# Goal - 与 HybridPointsSeqTracking.srv 的 Request 一致
geometry_msgs/PoseArray arm_poses       # tcp 臂目标序列
float64[] arm_states                    # 每个点期望的关节角度（展平），empty 则默认不动
int8 joint_num                          # arm 关节角度个数 -> wa1 7, wa2 8
float64[] time_points                   # 每段时长
float64 max_period                      # 最大等待周期
float64 track_weight                    # 每段跟踪权重
string way_type                         # "quintic", "spline"
string major_arm                        # "left", "right"

---
# Result - 与 HybridPointsSeqTracking.srv 的 Response 一致
bool success

---
# Feedback - 执行过程中的进度反馈
uint32 current_segment_index            # 当前所在段索引
uint32 total_segments                   # 总段数
float32 segment_progress                # 当前段内进度 0.0 ~ 1.0
float32 progress                        # 整体进度 0.0 ~ 1.0
float64 time_elapsed                    # 已执行时间（秒）
