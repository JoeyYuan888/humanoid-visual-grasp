# Python/cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments
.venv/
.env
.env.*

# Runtime data/logs
data/grasp_data_*.csv
data/qr_debug_*.csv
